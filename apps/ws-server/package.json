  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@workspace/redis-streams": "workspace:*",
    "@workspace/shared": "*",
    "dotenv": "^17.4.2",
    "uuid": "^14.0.1",
    "ws": "^8.18.0"
  }
}